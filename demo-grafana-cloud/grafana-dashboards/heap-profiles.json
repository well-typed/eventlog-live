                      "spec": {
                        "disableTextWrap": false,
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "    (\n        ghc_eventlog_HeapProfSample_bytes{service_name=\"$service_name\",heapProfBreakdown=\"$heap_prof_breakdown\"}\n    and\n        topk(\n            $heap_prof_sample_limit,\n            sum_over_time(\n                ghc_eventlog_HeapProfSample_bytes{service_name=\"$service_name\",heapProfBreakdown=\"$heap_prof_breakdown\"}[${__range}] @ ${__to:date:seconds}\n            )\n        )\n    )\nor\n    sum by(service_name)\n    (\n        (\n                ghc_eventlog_HeapProfSample_bytes{service_name=\"$service_name\",heapProfBreakdown=\"$heap_prof_breakdown\"}\n            unless\n                topk(\n                    $heap_prof_sample_limit,\n                    sum_over_time(\n                        ghc_eventlog_HeapProfSample_bytes{service_name=\"$service_name\",heapProfBreakdown=\"$heap_prof_breakdown\"}[${__range}] @ ${__to:date:seconds}\n                    )\n                )\n        )\n    )",
                        "fullMetaSearch": false,
                        "includeNullMetadata": true,
                        "instant": false,
                        "legendFormat": "{{heapProfLabel}}\\{{ipName}}",
                        "range": true,
                        "useBackend": false
