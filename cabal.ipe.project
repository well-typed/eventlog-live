import: cabal.project

-- 2026-06-18:
-- enable info-table maps for all packages
package *
  ghc-options:
    -finfo-table-map
    -fdistinct-constructor-tables

-- 2026-06-26:
-- relax all package constraints
if impl(ghc >=10)
  allow-newer: *

-- 2026-07-28:
-- require a version of hashable that is compatible with GHC 10
if impl(ghc >=10)
  constraints: hashable==1.4.7.0
